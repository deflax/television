# General
SERVER_NAME=example.com
EMAIL=info@example.com
ACCOUNT_THUMBPRINT=CHANGE_ME

CORE_LOG_LEVEL=warn
CORE_API_HOSTNAME=stream.example.com
CORE_API_AUTH_USERNAME=admin
CORE_API_AUTH_PASSWORD=CHANGE_ME
# Current-channel ICY metadata polling for Now Playing display.
# METADATA_POLL_INTERVAL=15
# METADATA_TIMEOUT=3.5

# Flask Session and Timecode Configuration
FLASK_SECRET_KEY=CHANGE_ME
TIMECODE_SECRET_KEY=CHANGE_ME

# Enable the Discord bot
DISCORDBOT_ENABLED=true

# Discord Bot Token
DISCORDBOT_TOKEN=your_discord_bot_token_here

# Discord Channel IDs
DISCORDBOT_LIVE_CHANNEL_ID=123456789
DISCORDBOT_TIMECODE_CHANNEL_ID=123456789

# Update interval for live announcements (in minutes)
DISCORDBOT_LIVE_CHANNEL_UPDATE=1440

# Mux service mode: 'copy' (passthrough, no transcoding) or 'abr' (adaptive bitrate)
MUX_MODE=copy
MUX_LOG_LEVEL=info

# ABR encoding settings (only used when MUX_MODE=abr)
ABR_PRESET=veryfast
ABR_GOP_SIZE=48
# ABR threads per encoder (0=auto/unlimited, default: 2). Lower = less CPU, higher latency.
# ABR_THREADS=2

# ABR variants (JSON array). audio_bitrate is used for playlist bandwidth metadata; audio is copied.
# Each variant: {"width": W, "height": H, "video_bitrate": "Xk", "audio_bitrate": "Yk"}
# Default: [{"width":1280,"height":720,"video_bitrate":"1500k","audio_bitrate":"128k"}]
# ABR_VARIANTS=[{"width":1280,"height":720,"video_bitrate":"1500k","audio_bitrate":"128k"}]

# HLS segment and viewer tracking settings
# HLS_SEGMENT_TIME=4
# HLS_LIST_SIZE=20
# HLS segment cache headers and file retention. Retention is clamped so it covers
# the playlist window plus max-age + stale-while-revalidate.
# HLS_SEGMENT_CACHE_MAX_AGE=300
# HLS_SEGMENT_CACHE_STALE_REVALIDATE=60
# HLS_SEGMENT_RETENTION_SECONDS=440
# HLS viewer inactivity timeout in seconds before a playlist-polling viewer is expired.
# HLS_VIEWER_TTL=90

# VOD-to-HLS channel. Compose maps these names to the producer's internal variables.
# Input media is always read from ./data/archive and raw HLS stays internal-only.
VOD_HLS_PLAYLIST=live.m3u8
VOD_SEGMENT_SECONDS=4
VOD_PLAYLIST_SIZE=6
VOD_RESCAN_SECONDS=30
VOD_OUTPUT_WIDTH=1920
VOD_OUTPUT_HEIGHT=1080
VOD_OUTPUT_FPS=30
VOD_SUPPORTED_EXTENSIONS=.mp4,.mkv,.mov,.avi,.webm,.m4v
# Optional integer for deterministic playback order; leave empty for random order.
VOD_SHUFFLE_SEED=
VOD_LOG_LEVEL=INFO
